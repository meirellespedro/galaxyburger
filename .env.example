# ============================================================
# Storage Mode Configuration
# ============================================================
# Options: "file", "kv" or unset (auto)
# - Local (sem VERCEL definido): usa "file" por padrao, gravando em ./data
# - Na Vercel: usa "kv" automaticamente se UPSTASH_REDIS_REST_URL e
#   UPSTASH_REDIS_REST_TOKEN estiverem configurados; caso contrario cai em
#   modo somente leitura (nenhum volume persistente entre execucoes).
# So defina estas variaveis para forcar um modo especifico.
# INVENTORY_STORAGE_MODE=file
# DELIVERY_AREAS_STORAGE_MODE=file
# STORE_STATUS_STORAGE_MODE=file
# ORDER_TICKET_STORAGE_MODE=file

# ============================================================
# Upstash Redis (armazenamento persistente em producao)
# ============================================================
# Gratuito para sempre no plano free (nao exige cartao de credito).
# 1. Crie uma conta em https://console.upstash.com
# 2. Crie um banco Redis (regiao mais proxima do deploy na Vercel)
# 3. Copie "REST URL" e "REST TOKEN" e cole aqui / nas env vars da Vercel
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ============================================================
# Local File Storage Paths (for development)
# ============================================================
# These are only used when STORAGE_MODE=file
INVENTORY_STATUS_FILE_PATH=./data/inventory-status.json
DELIVERY_AREAS_FILE_PATH=./data/delivery-areas.json
STORE_STATUS_FILE_PATH=./data/store-status.json
ORDER_TICKET_DIRECTORY_PATH=./data/order-tickets

# ============================================================
# Admin Panel Configuration
# ============================================================
# IMPORTANT: Use strong, unique passwords in production
ADMIN_PANEL_PASSWORD=your_very_secure_password_here_change_this
ADMIN_PANEL_SECRET=your_secure_secret_key_for_session_management

# ============================================================
# Optional: Additional Secrets
# ============================================================
# These can be used as fallbacks for session management
DELIVERY_QUOTE_SECRET=your_delivery_quote_secret_here
ORDER_TICKET_SECRET=your_order_ticket_secret_here
